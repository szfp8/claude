{
  "name": "white-label-cloudflare-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node scripts/predeploy.mjs",
    "deploy": "node scripts/deploy-all.mjs",
    "deploy:all": "node scripts/deploy-all.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "db:create-admin": "node scripts/create-admin.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "postdeploy:check": "node scripts/postdeploy-check.mjs",
    "test": "node --test",
    "verify": "node scripts/verify-repository.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "validate:complete": "npm run doctor && npm run verify && npm run typecheck && npm run check:deployment && npm run check:migrations && npm run check:whitelabel && npm run check:contact-fields && npm test"
  },
  "dependencies": {
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "typescript": "5.9.3",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": "26.10.0"
  }
}
